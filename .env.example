# ==========================================
# OrderOne.in Platform Environment Variables
# ==========================================

# Base URL for QR codes and storefront links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional public analytics and verification IDs (set only for the matching production properties)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_CONVERSION=
NEXT_PUBLIC_GOOGLE_ADS_TRIAL_CONVERSION=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_CONVERSION=
NEXT_PUBLIC_META_PIXEL_ID=

# Supabase Managed Database & Auth (for production deployment)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay Indian Payment Gateway & Subscriptions
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Optional SMS / WhatsApp Notifications Gateway
SMS_GATEWAY_API_KEY=
WHATSAPP_BUSINESS_TOKEN=
